[Unit]
Description=Balam bot + Mini App server (ADR-0011/0013)
After=network-online.target@OPENCODE_AFTER@
Wants=network-online.target
@OPENCODE_REQUIRES@

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@/apps/backend
# Secrets + config from the repo .env (read by pydantic-settings). The optional
# deploy/balam.env (note the leading "-") overlays the public-mode settings the
# tunnel needs — BALAM_PUBLIC_URL and BALAM_MINIAPP_SHORTNAME — and is rewritten
# by deploy/refresh-tunnel-url.sh under a quick tunnel. Later EnvironmentFile
# wins, and a real env var beats the repo .env (ADR-0008), so these take effect.
EnvironmentFile=@REPO@/.env
EnvironmentFile=-@REPO@/deploy/balam.env
# systemd derives HOME from User=, but state it so the agent subprocess and its
# tool shells cannot inherit a surprising one.
Environment=HOME=@HOME@
# Which Claude account this bot runs as. Empty by default — the `claude` CLI then
# uses ~/.claude, which is the right answer on a single-bot machine. Set
# BALAM_PRIMARY_CLAUDE_CONFIG_DIR in deploy/deploy.env to pin it elsewhere, which
# is what you want when ~/.claude is a PERSON's interactive login rather than the
# bot's: the bot then cannot be re-pointed by whoever runs `claude auth login` in
# a terminal. Extra instances always pin it (balam@.service).
#
# CAUTION: systemd applies EnvironmentFile= *over* Environment=, whatever the
# order in this file, so a CLAUDE_CONFIG_DIR line in the repo .env would win over
# this. The install scripts refuse that line for exactly that reason.
@PRIMARY_CLAUDE_ENV@
# Which GitHub account the agent's `gh` runs as — and, because the git
# credential helper is `gh auth git-credential`, which account its `git push`
# authenticates as too. gh keeps ONE active account per config directory, in
# $GH_CONFIG_DIR/hosts.yml; the default is ~/.config/gh, which every instance on
# this OS user shares, so `gh auth switch` in any of them silently repoints all
# the others. CLAUDE_CONFIG_DIR does not scope this — gh knows nothing about it.
# Empty by default. Set BALAM_PRIMARY_GH_CONFIG_DIR in deploy/deploy.env to give
# this bot its own; extra instances always get one (balam@.service). Same
# EnvironmentFile CAUTION as above — the install script refuses a GH_CONFIG_DIR
# line in the repo .env.
@PRIMARY_GH_ENV@
# Rendered by deploy/lib.sh from the toolchains actually present in @HOME@
# (bun, nvm's node, cargo, go), so it does not drift from the machine. In
# claude_sdk mode (AGENT_BACKEND=claude_sdk) the agent subprocess
# is spawned by THIS unit — the SDK merges its env over the inherited one — so
# its tool shells only see this PATH. Without it, user-installed CLIs (Go
# binaries in ~/go/bin like printify, node, bun, glab, …) are not found.
Environment=PATH=@PATH@
Environment=GOPATH=@GOPATH@
ExecStart=@UV@ run balam
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
