# An EXTRA Balam instance — a second bot on a second Claude account, on this same
# VM and OS user. The first instance stays plain balam.service; this template is
# only for the ones after it.
#
# Instance %i is a SEPARATE CHECKOUT at @INSTANCE_ROOT@/@INSTANCE_PREFIX@-%i with its
# own .env (bot token, BALAM_PORT), its own config.yaml, its own balam.sqlite,
# and its own Claude login under @HOME@/.claude-%i.
#
# Install with deploy/install-instance.sh %i — it checks the things that break
# quietly rather than loudly (a shared port, a reused bot token, an overridden
# CLAUDE_CONFIG_DIR, a config dir that was never logged in).

[Unit]
Description=Balam bot + Mini App server, instance %i (ADR-0011/0013/0014)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@INSTANCE_ROOT@/@INSTANCE_PREFIX@-%i/apps/backend

# This one line is what makes the instance a second Claude account. The `claude`
# CLI resolves its whole identity from CLAUDE_CONFIG_DIR (default ~/.claude):
# .credentials.json, .claude.json, projects/, sessions/, settings.json, skills/,
# plugins/. balam.service leaves it unset, so the first instance keeps ~/.claude.
# The Agent SDK spawns the CLI with the inherited environment merged under its own
# options (claude_agent_sdk .../subprocess_cli.py), so setting it here reaches the
# agent — Balam needs no code change for this.
#
# CAUTION: systemd applies EnvironmentFile= *over* Environment=, whatever the
# order in this file. A CLAUDE_CONFIG_DIR line in the instance .env would
# therefore win, and this instance would silently run as the first instance's
# Claude account. install-instance.sh refuses that line for exactly this reason.
Environment=CLAUDE_CONFIG_DIR=@HOME@/.claude-%i

# The same isolation for GitHub. gh keeps ONE active account per config
# directory, in $GH_CONFIG_DIR/hosts.yml, and the default ~/.config/gh is shared
# by every instance on this OS user — so without this line `gh auth switch` in
# any instance repoints all of them, and the account is simply whoever logged in
# last. gh knows nothing about CLAUDE_CONFIG_DIR, so that separation does not
# imply this one. It reaches `git push` as well: the credential helper is
# `gh auth git-credential`, which reads this same variable.
#
# Seed the directory once, with the account this instance should be:
#   GH_CONFIG_DIR=@HOME@/.config/gh-%i gh auth login
# install-instance.sh creates it and copies the shared config.yml (aliases,
# git_protocol) if it is missing.
Environment=GH_CONFIG_DIR=@HOME@/.config/gh-%i
Environment=HOME=@HOME@

# Secrets + config from this instance's own checkout. Same layering as
# balam.service: the repo .env, then the optional public-mode overlay (note the
# leading "-") holding BALAM_PUBLIC_URL and BALAM_MINIAPP_SHORTNAME.
EnvironmentFile=@INSTANCE_ROOT@/@INSTANCE_PREFIX@-%i/.env
EnvironmentFile=-@INSTANCE_ROOT@/@INSTANCE_PREFIX@-%i/deploy/balam.env

# Rendered by deploy/lib.sh from the toolchains present on the machine (same as
# balam.service). The agent subprocess is spawned by THIS unit, so its tool shells only
# see this PATH; without it, user-installed CLIs (node, bun, glab, Go binaries in
# ~/go/bin) are not found.
Environment=PATH=@PATH@
Environment=GOPATH=@GOPATH@

# No Requires=balam-opencode.service: extra instances are claude_sdk-only
# (ADR-0014). The OpenCode path would need a second server on its own port and
# its own OPENCODE_DB, which this template does not set up.
ExecStart=@UV@ run balam
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
